<component name="functions" type="synapse/template">
    <subComponents>
        <component name="sendIDoc">
            <displayName>send idoc</displayName>
            <file>sendIDoc.xml</file>
            <description>Sends an IDoc to the SAP system over tRFC, including TID creation and confirmation.
</description>
        </component>
        <component name="execute">
            <displayName>execute</displayName>
            <file>execute.xml</file>
            <description>Calls an RFC-enabled function module on the SAP system and returns the response.
</description>
        </component>
        <component name="close">
            <displayName>close</displayName>
            <file>close.xml</file>
            <description>Releases the JCo destination registered for this client. Call this when the client is no
longer needed to free the destination ID for reuse. Calling this more than once is safe.
</description>
        </component>
        </subComponents>
</component>
