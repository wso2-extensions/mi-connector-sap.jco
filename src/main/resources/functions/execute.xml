<template xmlns="http://ws.apache.org/ns/synapse" name="execute">
    <parameter name="responseVariable" description="The target variable in which the output of the operation will be stored"/>
    <parameter name="overwriteBody" description="Replace the Message Body in Message Context with the output payload of the operation"/>
    <parameter name="functionName" description=""/>
    <parameter name="importParameters" description="Scalar values and structures sent to SAP as import parameters"/>
    <parameter name="tableParameters" description="Named tables sent to SAP as table parameters, where each entry maps a table parameter name to its rows"/>
    <parameter name="returnTypeDataType" description="Select the data type for 'returnType' parameter"/>
    <sequence>
        <property name="param0" value="functionName"/>
        <property name="paramType0" value="string"/>
        <property name="param1" value="parameters"/>
        <property name="paramType1" value="record"/>
        <property name="param1_recordName" value="RfcParameters" />
        <property name="param1_recordOrg" value="ballerinax" />
        <property name="param1_recordModule" value="sap.jco" />
        <property name="parameters_param0" value="importParameters"/>
        <property name="parameters_paramType0" value="record"/>
        <property name="parameters_param1" value="tableParameters"/>
        <property name="parameters_paramType1" value="map"/>
        <property name="param2" value="returnTypeDataType"/>
        <property name="paramType2" value="typedesc"/>
        <property name="paramSize" value="3"/>
        <property name="paramFunctionName" value="execute"/>
        <property name="returnType" value="union"/>
        <property name="functionType" value="REMOTE"/>
        <class name="io.ballerina.stdlib.mi.BalConnectorFunction">
            <property name="orgName" value="ballerinax"/>
            <property name="moduleName" value="sap.jco"/>
            <property name="version" value="2"/>
        </class>
    </sequence>
</template>
