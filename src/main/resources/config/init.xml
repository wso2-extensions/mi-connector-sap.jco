<template name="init" onError="fault" xmlns="http://ws.apache.org/ns/synapse">
    <parameter name="name" description="Unique name the connection is identified by"/>
    <parameter name="connectionType" description="Connection type"/>
    <parameter name="configDataType" description=""/>
    <parameter name="config_ashost" description="SAP application server host name"/>
    <parameter name="config_sysnr" description="SAP system number"/>
    <parameter name="config_jcoClient" description="SAP client number"/>
    <parameter name="config_user" description="SAP logon user name"/>
    <parameter name="config_passwd" description="SAP logon password"/>
    <parameter name="config_lang" description="SAP logon language"/>
    <parameter name="config_group" description="SAP logon group for load balancing"/>
    <parameter name="configMap" description=""/>
    <parameter name="destinationId" description=""/>
    <sequence>
        <property name="SAP_JCO_CLIENT_objectTypeName" value="Client"/>
        <property name="SAP_JCO_CLIENT_paramSize" value="2"/>
        <property name="SAP_JCO_CLIENT_paramFunctionName" value="init"/>
        <property name="SAP_JCO_CLIENT_param0" value="config"/>
        <property name="SAP_JCO_CLIENT_paramType0" value="union"/>
        <property name="SAP_JCO_CLIENT_dataType0" value="configDataType"/>
        <property name="SAP_JCO_CLIENT_param0UnionDestinationConfig" value="config_DestinationConfig"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_param0" value="config.ashost"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_paramType0" value="string"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_unionMember0" value="DestinationConfig"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_param1" value="config.sysnr"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_paramType1" value="string"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_unionMember1" value="DestinationConfig"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_param2" value="config.jcoClient"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_paramType2" value="string"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_unionMember2" value="DestinationConfig"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_param3" value="config.user"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_paramType3" value="string"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_unionMember3" value="DestinationConfig"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_param4" value="config.passwd"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_paramType4" value="string"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_unionMember4" value="DestinationConfig"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_param5" value="config.lang"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_paramType5" value="string"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_unionMember5" value="DestinationConfig"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_param6" value="config.group"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_paramType6" value="string"/>
        <property name="SAP_JCO_CLIENT_config_DestinationConfig_unionMember6" value="DestinationConfig"/>
        <property name="SAP_JCO_CLIENT_param0UnionMap" value="configMap"/>
        <property name="SAP_JCO_CLIENT_param1" value="destinationId"/>
        <property name="SAP_JCO_CLIENT_paramType1" value="string"/>

        <class name="io.ballerina.stdlib.mi.BalConnectorConfig">
            <property name="orgName" value="ballerinax"/>
            <property name="moduleName" value="sap.jco"/>
            <property name="version" value="2"/>
        </class>
    </sequence>
</template>
